                              [ - 1  - 1  0         0        ]
                              [                              ]
                              [ - 1   0   0         0        ]
                              [                              ]
                          g = [            2                 ]
                              [  0    0   r         0        ]
                              [                              ]
                              [                2    2        ]
                              [  0    0   0   r  sin (theta) ]

     (%o5)                                done

