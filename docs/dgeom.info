                                       2
     (%i4) lg_in:matrix([-rho^2,0],[0,1]);
                                      [      2    ]
     (%o4)                            [ - rho   0 ]
                                      [           ]
                                      [   0     1 ]
     (%i5) dg_metric(cnvrt2);
                                      2           2    2
                          ds2_in = del (rho) - rho  del (omega)

                                        [ - xi  0  ]
                                        [          ]
