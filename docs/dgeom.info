   Using ‘dg_metric(cnvrt3)’

     (%i1) cords_in:[omega,rho];
     (%o1)                            [omega, rho]
     (%i2) cords_ot:[t,xi];
     (%o2)                               [t, xi]
     (%i3) cords_tr:[t/2,2*sqrt(xi)];
                                      t
     (%o3)                           [-, 2 sqrt(xi)]
                                      2
     (%i4) lg_in:matrix([-rho^2,0],[0,1]);
                                      [      2    ]
     (%o4)                            [ - rho   0 ]
                                      [           ]
                                      [   0     1 ]
     (%i5) dg_metric(cnvrt3);
                                      2           2    2
                          ds2_in = del (rho) - rho  del (omega)

